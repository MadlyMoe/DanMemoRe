<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="dev.danmemore.launcher.INTERNAL_STATUS" android:protectionLevel="signature" />
    <uses-permission android:name="dev.danmemore.launcher.INTERNAL_STATUS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="com.eu.danmore" /></queries>
    <application android:allowBackup="false" android:label="DanMemoRe" android:pageSizeCompat="enabled"
        android:largeHeap="true" android:usesCleartextTraffic="true" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".NodeListenerService" android:exported="false" android:process=":listener"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local DanMemoRe server" />
        </service>
        <service android:name=".ContentImportService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
